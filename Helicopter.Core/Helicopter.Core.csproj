<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <!-- PrivateAssets="all" keeps MonoGame types resolvable at compile time for Core
         without flowing this DesktopGL dependency to consumers (Web, WindowsDX, etc.).
         Each platform project provides its own MonoGame runtime reference. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" PrivateAssets="all" />
  </ItemGroup>
</Project>
